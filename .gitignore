# Web related

# Exceptions to above rules.
!/packages/flutter_tools/test/data/dart_dependencies_setup/**/packages/foo/**/lib/*
!/packages/flutter_tools/test/data/dart_dependencies_setup/**/packages/foo/**/packages/foo/*
!/packages/flutter_tools/test/data/dart_dependencies_setup/**/packages/foo/pubspec.yaml
!/packages/flutter_tools/test/data/dart_dependencies_setup/**/packages/foo/pubspec.lock

