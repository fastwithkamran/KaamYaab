rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // ── Helpers ──────────────────────────────────────────────────────────────

    /// True when the request comes from a signed-in Firebase Auth user.
    function isAuth() {
      return request.auth != null;
    }

    /// True when the signed-in user is accessing their own document.
    function isSelf(uid) {
      return isAuth() && request.auth.uid == uid;
    }

    // ── 1. Users Collection ───────────────────────────────────────────────────
    // Any authenticated user can read worker profiles (needed for Browse screen).
    // Only the owner can create or update their own document.
    match /users/{userId} {
      allow read:   if isAuth();
      allow create: if isSelf(userId);
      allow update: if isSelf(userId);
      allow delete: if false;
    }

    // ── 2. Bookings Collection ────────────────────────────────────────────────
    // Only the customer or assigned worker can read/update a booking.
    // Any authenticated user can create a new booking.
    match /bookings/{bookingId} {
      allow read:   if isAuth() && (
                      resource.data.customer_uid == request.auth.uid ||
                      resource.data.worker_uid   == request.auth.uid
                    );
      allow create: if isAuth();
      allow update: if isAuth() && (
                      resource.data.customer_uid == request.auth.uid ||
                      resource.data.worker_uid   == request.auth.uid
                    );
      allow delete: if false;
    }

    // ── 3. Service Providers (legacy alias of users) ──────────────────────────
    // Readable by any authenticated user; writable only by the owner.
    match /providers/{providerId} {
      allow read:   if isAuth();
      allow write:  if isSelf(providerId);
    }

    // ── 4. Worker Locations ───────────────────────────────────────────────────
    // Readable by any authenticated user (needed for map/matching).
    // Only the worker themselves can write their location.
    match /worker_locations/{workerId} {
      allow read:   if isAuth();
      allow write:  if isSelf(workerId);
    }

    // ── 5. Customer Notifications ─────────────────────────────────────────────
    // Strictly private — only readable/writable by the owning customer.
    match /customer_notifications/{customerId} {
      allow read, write: if isSelf(customerId);

      match /items/{itemId} {
        allow read, write: if isSelf(customerId);
      }
    }

    // ── 6. Worker Notifications ───────────────────────────────────────────────
    // Strictly private — only readable/writable by the owning worker.
    match /worker_notifications/{workerId} {
      allow read, write: if isSelf(workerId);

      match /items/{itemId} {
        allow read, write: if isSelf(workerId);
      }
    }

    // ── Catch-all: deny everything else ──────────────────────────────────────
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
